{
  "name": "mysql-ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["web", "app"],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "dev:web": "bun run --cwd web dev",
    "dev:client": "bun run --cwd web dev:client",
    "dev:server": "bun run --cwd web dev:server",
    "dev:app": "bun run --cwd web dev:client & bun run --cwd app dev",
    "build": "bun run --cwd web build",
    "build:app": "bun run --cwd app build",
    "start:app": "bun run --cwd app start",
    "dist:app": "bun run --cwd app dist"
  }
}
